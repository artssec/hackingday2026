# Copiá este archivo a .env (o dejá que ./scripts/setup.sh lo haga).
# Sin comillas ni espacios alrededor del "=".

# Versión de Wazuh
WAZUH_VERSION=4.14.8

# Dashboard/API de Hermes (setup.sh los genera si están vacíos)
DASHBOARD_PASSWORD=
DASHBOARD_SECRET=
API_SERVER_KEY=

# API key de OpenCode Go (https://opencode.ai/auth)
OPENCODE_API_KEY=
# Token del bot de Telegram (@BotFather)
TELEGRAM_BOT_TOKEN=
# Tu ID numérico de Telegram (@userinfobot): quién puede hablarle al bot y destino de los avisos
TELEGRAM_USER_ID=

# Opcionales
# Nivel mínimo de alerta que revisa el cron
WAZUH_MIN_LEVEL=5

# Minutos hacia atrás que reprocesa `make replay`
REPLAY_MINUTES=10

# Zona horaria para mostrar las horas
LAB_TIMEZONE=America/Argentina/Buenos_Aires
